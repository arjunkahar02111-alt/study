# Flask Session Secret (generate a long random string for production)
SECRET_KEY=replace-with-strong-random-secret-key

# Firebase Web App Configuration (Firebase Console -> Project Settings -> Your Apps -> Web App)
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=

# Optional: Only needed if you also use Firebase Admin SDK locally (do NOT commit JSON keys)
# FIREBASE_SERVICE_ACCOUNT_JSON=
