rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidOwnerField(uid) {
      return request.resource.data.ownerUid == uid;
    }

    function ownerUnchanged() {
      return !('ownerUid' in resource.data)
        || request.resource.data.ownerUid == resource.data.ownerUid;
    }

    match /users/{uid} {
      // Root user document if referenced
      allow read, write: if isOwner(uid);

      // User Profile (created/updated strictly by owner)
      match /profile/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidOwnerField(uid)
          && request.resource.data.email is string;
        allow update: if isOwner(uid)
          && hasValidOwnerField(uid)
          && ownerUnchanged();
        allow delete: if isOwner(uid);
      }

      // User Settings & Preferences
      match /settings/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerField(uid)
          && ownerUnchanged();
        allow delete: if isOwner(uid);
      }

      // Personal Study Routines & Weekly Schedules
      match /routines/{routineId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidOwnerField(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.dayOfWeek is string;
        allow update: if isOwner(uid)
          && hasValidOwnerField(uid)
          && ownerUnchanged();
        allow delete: if isOwner(uid);
      }

      // Tasks & Assignments (with embedded subtasks)
      match /tasks/{taskId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidOwnerField(uid)
          && request.resource.data.Task_Title is string
          && request.resource.data.Task_Title.size() > 0
          && request.resource.data.Task_Subject is string
          && request.resource.data.Task_Difficulty is int
          && request.resource.data.Task_Difficulty >= 1
          && request.resource.data.Task_Difficulty <= 5
          && request.resource.data.Task_Importance is int
          && request.resource.data.Task_Importance >= 1
          && request.resource.data.Task_Importance <= 5
          && request.resource.data.Task_Status in ['Pending', 'Completed'];
        allow update: if isOwner(uid)
          && hasValidOwnerField(uid)
          && ownerUnchanged()
          && request.resource.data.Task_Difficulty >= 1
          && request.resource.data.Task_Difficulty <= 5
          && request.resource.data.Task_Importance >= 1
          && request.resource.data.Task_Importance <= 5
          && request.resource.data.Task_Status in ['Pending', 'Completed'];
        allow delete: if isOwner(uid);
      }

      // Subjects, Study Sessions, Active Timer Session, Goals, Progress, Analytics
      match /subjects/{subjectId} {
        allow read, write: if isOwner(uid) && (request.method == 'delete' || hasValidOwnerField(uid));
      }

      match /study_sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerField(uid)
          && ownerUnchanged();
        allow delete: if isOwner(uid);
      }

      match /active_session/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerField(uid)
          && ownerUnchanged();
        allow delete: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(uid) && (request.method == 'delete' || hasValidOwnerField(uid));
      }

      match /progress/{docId} {
        allow read, write: if isOwner(uid) && (request.method == 'delete' || hasValidOwnerField(uid));
      }

      match /analytics/{docId} {
        allow read, write: if isOwner(uid) && (request.method == 'delete' || hasValidOwnerField(uid));
      }
    }

    // Deny all access outside users/{uid}
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
